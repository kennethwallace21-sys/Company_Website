{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // /api/send-email: 5 requests per 60 s per client IP (CF-Connecting-IP), counted per
  // Cloudflare location. src/worker.js falls back to an in-memory Map without it.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "41018",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
